{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "apirelio/slim",
    "description": "Fail-safe Slim 4 middleware for Apirelio customer integration analytics.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "apirelio/php-core": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "slim/slim": "^4.15"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "slim/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Apirelio\\Slim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Apirelio\\Slim\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php-core",
            "options": {
                "symlink": true,
                "versions": {
                    "apirelio/php-core": "1.0.1"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
